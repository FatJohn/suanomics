# ============================================================
# Official Node.gitignore (github/gitignore, main)
# ============================================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# ============================================================
# Project-specific additions
# ============================================================

# Turborepo（若採用 monorepo）
.turbo/

# Bun lockfile（若採用 bun；目前選 pnpm、保險加上）
bun.lockb

# ============================================================
# OS / Editor (cross-platform)
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (WebStorm / IntelliJ)
.idea/
*.iml

# Vim / Emacs
*.swp
*.swo
\#*\#
.\#*

# ============================================================
# Claude Code / AI Tools
# ============================================================

# .claude/ 是 Claude Code 的本機狀態（設定、worktree 等），依機器與使用者而異，不進 git。
.claude/*

# ============================================================
# Local data（MVP 用、不提交）
# ============================================================

# SQLite 本地檔
*.sqlite
*.sqlite3
*.db
*.db-journal

# 臨時檔
*.tmp

# ============================================================
# _candidates/ 由
# runCompile auto-create 作為 candidate prompt 落地點、屬 runtime
# artifact（保留 10 個 run 後 pruneOldCandidates 清舊）、不入 git
# ============================================================
/packages/prompts/

# ============================================================
# vue-tsc project-reference emit artifacts
# （應只存在 dist/、不應 leak 進 apps/web/src/）
# ============================================================
apps/web/src/**/*.js
apps/web/src/**/*.vue.js
apps/web/src/**/*.d.ts
apps/web/tsconfig.node.tsbuildinfo
apps/web/tsconfig.tsbuildinfo

# brief-eval：CLI 報告落地點（runtime artifact、不入 git）
apps/server/.eval-out/

# LocalPodcastStorage 的落地點（PODCAST_STORAGE_KIND=local 時的 mp3、
# 見 packages/db/src/storage/podcast-storage.ts）。同樣是 runtime artifact。
apps/server/.audio-cache/

# Playwright MCP 截圖暫存
.playwright-mcp/
