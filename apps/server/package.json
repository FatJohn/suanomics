{
  "name": "server",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint .",
    "market-data:refresh": "tsx --env-file-if-exists=.env tools/cli/market-data-refresh.ts",
    "news:refresh": "tsx --env-file-if-exists=.env tools/cli/news-refresh.ts",
    "news:health": "tsx --env-file-if-exists=.env tools/cli/news-health.ts",
    "news:backfill-tags": "tsx --env-file-if-exists=.env tools/cli/news-backfill-tags.ts",
    "demo:seed": "tsx --env-file-if-exists=.env tools/cli/demo-seed.ts",
    "corpus:refresh": "tsx --env-file-if-exists=.env tools/cli/corpus-refresh.ts",
    "brief:generate": "tsx --env-file-if-exists=.env tools/cli/brief-generate.ts",
    "podcast:generate": "tsx --env-file-if-exists=.env tools/cli/podcast-generate.ts",
    "podcast:tts": "tsx --env-file-if-exists=.env tools/cli/podcast-tts.ts",
    "prompt:distill": "tsx --env-file-if-exists=.env tools/cli/prompt-research-distill.ts",
    "prompt:compile": "tsx --env-file-if-exists=.env tools/cli/prompt-research-compile.ts",
    "prompt:refresh": "tsx --env-file-if-exists=.env tools/cli/prompt-refresh.ts",
    "brief:quality": "tsx --env-file-if-exists=.env tools/cli/brief-quality.ts",
    "brief:continuity": "tsx --env-file-if-exists=.env tools/cli/brief-continuity.ts",
    "brief:canary": "tsx --env-file-if-exists=.env tools/cli/brief-canary.ts",
    "brief:rerun": "tsx --env-file-if-exists=.env tools/cli/brief-rerun.ts",
    "model:ab": "tsx --env-file-if-exists=.env tools/cli/model-ab.ts",
    "prod:ledger-metrics": "tsx tools/cli/prod-ledger-metrics.ts",
    "ledger:ab": "tsx --env-file-if-exists=.env tools/cli/narrative-ledger-ab.ts",
    "claim:yield": "tsx --env-file-if-exists=.env tools/cli/claim-yield-smoke.ts",
    "storyline:continuity-ab": "tsx --env-file-if-exists=.env tools/cli/storyline-continuity-ab.ts",
    "fixtures:check": "tsx src/fixtures/cli.ts",
    "fixtures:check-canary": "tsx tools/cli/canary-ticker-check.ts",
    "transcript": "tsx --env-file-if-exists=.env tools/cli/transcript.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@breezystack/lamejs": "^1.2.7",
    "@google/genai": "^2.23.0",
    "@hono/node-server": "^2.1.1",
    "@suanomics/db": "workspace:*",
    "@suanomics/jobs": "workspace:*",
    "@suanomics/prompt-research": "workspace:*",
    "@suanomics/shared": "workspace:*",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.8",
    "js-yaml": "^5.4.2",
    "postgres": "^3.4.9",
    "undici": "^7.29.1",
    "unpdf": "^1.8.1",
    "youtube-transcript-plus": "^2.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
