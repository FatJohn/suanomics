# ─────────────────────────────────────────────────────────────────────
# apps/server 本機開發 .env 範例
# 複製這檔到 apps/server/.env 後、填上敏感欄位（GEMINI_API_KEY 等）
#   cp apps/server/.env.example apps/server/.env
# 之後 `pnpm dev:server` 與所有 pipeline CLI 都吃這檔
#
# 每個變數的設計理由、啟動檢查分級（[FATAL] 擋啟動／[DEGRADED] 只大聲 log）與已知陷阱，
# 見 docs/architecture/configuration.md（單一事實來源）；這裡只留「要不要填」。
# 檢查結果掛在 GET /api/ops/config-health。
# ─────────────────────────────────────────────────────────────────────

# ── Server ──
PORT=3000
NODE_ENV=development

# 前端 CORS 白名單（dev 用 localhost，部署時填 web 的公開 URL）。
# [DEGRADED，只在 NODE_ENV≠development 時檢查]：缺了瀏覽器端全被擋，HTTP 端點與每日 pipeline 照跑。
WEB_ORIGIN=http://localhost:5173

# ── Gemini API ──
# decomposer / analyst / synthesizer / editor / narrative / podcast-writer / TTS 都吃這把 key。
# [FATAL，條件式]：預設所有 agent 都是 gemini-* model，所以照樣要填；全部改走 openai
# 或逐 agent 覆寫到非 gemini 時可留空，只影響 podcast TTS 非 azure 分支有沒有音檔。
GEMINI_API_KEY=your-key-here

# ── LLM 模型路由（provider／model 選擇）──
# 完整規則、範例與陷阱見 docs/architecture/agents-and-prompts.md「模型解析與 provider gate」
# 與「接自己的 LLM」；下面四個只留「要不要填」。

# 總開關：是否真的允許 Anthropic 呼叫。預設一律 fallback Gemini（零 Claude 花費）。
# AI_PROVIDER=gemini

# 逐 agent override（'agent:model' 或 'agent:provider/model' 逗號分隔）；不填用預設。
AGENT_MODELS=

# 全域預設 provider（gemini/anthropic/openai），沒有顯式 provider 前綴的 model 用它退路。
# LLM_PROVIDER=

# ── OpenAI 相容 API（選填、只有 provider 解析到 openai 才需要）──
# 官方 OpenAI，或自架相容端點（vLLM／Ollama／LM Studio）與 OpenRouter。
# [FATAL，條件式]：與 Anthropic 不同，缺 key 是硬錯誤（不會 fallback），見上面那份文件。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# LLM_API_KEY=
# LLM_BASE_URL=

# 只影響 Transcript Tool（packages/prompt-research），與上面 Cascade agent 完全無關。
# TRANSCRIPT_TOOL_MODEL=gemini-3-flash-preview

# ── Anthropic API（選填、只有 AGENT_MODELS 用到 claude* 才需要）──
# [FATAL，條件式]：AI_PROVIDER=anthropic 且有 agent 指向 claude* 時才擋啟動。
ANTHROPIC_API_KEY=

# ── Seed 第三方來源開關（packages/db/src/source-policy.ts）──
# 只影響 `db:seed` / `seed:external-sources`，不影響 server 啟動。規則細節見
# docs/operations/local-dev.md「本機服務」。預設只啟用官方來源；設 'true' 才啟用商業媒體
# feed（自行確認各站 ToS）。
SEED_THIRD_PARTY_SOURCES=

# 已啟用中的第三方來源會被這次跑悄悄停用時，兩支 seed 會中止；設 'true' 表示你接受。
SEED_ALLOW_DOWNGRADE=

# ── Postgres ──
# 持久化 news_items / external_articles / background_jobs / analyses / daily_briefs
# [FATAL]。本機 docker `suanomics-postgres` 預設值。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/suanomics

# ── /internal/* 認證 ──
# `POST /internal/corpus/refresh` / `/internal/brief/enqueue` 等 trigger 用 Bearer。
# [FATAL]（NODE_ENV=development 時豁免）。部署時必填，`openssl rand -hex 32` 生成。
INGEST_TRIGGER_SECRET=

# ── POST /api/brief/analyze 限流（server 內建、in-memory、單 instance 前提）──
# 完整設計與部署建議見 docs/operations/deploy.md「放上公網前要知道的事」。
# 每個客戶端每分鐘上限；0 停用這一層。
ANALYZE_RATE_LIMIT_PER_CLIENT_PER_MIN=5
# 全域（不分客戶端）每小時上限；0 停用這一層。
ANALYZE_RATE_LIMIT_GLOBAL_PER_HOUR=60
# 'true' 時信任 X-Forwarded-For 最右邊一段當客戶端識別，僅適用「前面剛好一層
# 可信反向代理」的部署；預設（未設）一律用實際 TCP 連線來源，不信任任何 header。
TRUST_PROXY=

# 應用程式碼不再讀 Firecrawl 相關變數（gap-search 路徑已移除，見
# docs/architecture/runtime-flows.md 的 gap-scrape 說明）。

# ── FRED（market data、選填）── [DEGRADED]
# 缺 key 時 FRED 序列標「資料未更新」，TWSE 那半照跑。
FRED_API_KEY=

# ── Job concurrency（選填、逐 job kind 一個，命名規則見 apps/server/src/jobs/specs.ts）──
# 例：market-data-refresh -> MARKET_DATA_REFRESH_CONCURRENCY（預設 1）
# MARKET_DATA_REFRESH_CONCURRENCY=1

# ── 證據追溯（敘事裡的數字掛回分析來源）──
# 程式預設關閉；漏設不會 FATAL、不會 DEGRADED、不會有任何一行 log，報告照樣產得出來。
# 風險與量測見 docs/operations/deploy.md「環境變數」。只有字串 'true' 算開。
ANALYST_CLAIMS_ENABLED=true
NARRATIVE_LEDGER_ENABLED=true

# ── 並行與呼叫量上限 ──
# 命名慣例、全域有效尖峰公式與批次腳本節流見 docs/architecture/configuration.md
# 「並行與呼叫量上限」。

# RSS 來源並行抓取上限，與下面幾個 LLM fanout 變數無關。
NEWS_FETCH_CONCURRENCY=3
DECOMPOSER_FANOUT_CONCURRENCY=3
RETRIEVE_FANOUT_CONCURRENCY=3
ANALYST_TIER1_FANOUT_CONCURRENCY=3
MAX_LLM_CALLS_PER_JOB=150

# --- Podcast 音檔儲存（R2 object storage）---
# local（預設、dev，寫容器本地 .audio-cache）或 s3（部署環境、Cloudflare R2）。
# 值打錯字（例如 S3）會被靜默當成 local，見 docs/architecture/configuration.md。
PODCAST_STORAGE_KIND=local
# 以下僅 PODCAST_STORAGE_KIND=s3 時需要（讀寫在同一個 process，一起查）。[DEGRADED]
PODCAST_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
PODCAST_S3_BUCKET=podcast-audio
PODCAST_S3_ACCESS_KEY_ID=
PODCAST_S3_SECRET_ACCESS_KEY=
PODCAST_S3_REGION=auto
PODCAST_S3_PUBLIC_BASE_URL=https://<public-bucket-or-custom-domain>

# --- Podcast TTS provider（podcast-tts job）---
# gemini（預設，per-call 漂移故切段）或 azure（穩定，整集一次送）。
PODCAST_TTS_PROVIDER=gemini
# gemini 路徑的選用覆寫（留空用預設）。
PODCAST_TTS_VOICE=Algieba
PODCAST_TTS_MODEL=gemini-3.1-flash-tts-preview
# 以下僅 PODCAST_TTS_PROVIDER=azure 時需要（KEY/REGION 必填）。[DEGRADED]
# PROVIDER 值只認 azure 與 gemini（嚴格比對）；打錯字會靜默走 Gemini。
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=australiaeast
AZURE_SPEECH_VOICE=zh-TW-YunJheNeural
AZURE_SPEECH_RATE=1.1
