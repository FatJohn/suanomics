---
import type { GetStaticPaths } from 'astro'
import type { BriefView } from '../../lib/present-brief'
import BriefArticle from '../../components/BriefArticle.astro'
import Base from '../../layouts/Base.astro'
import { lectureNumbers } from '../../lib/handout'
import { getSiteData } from '../../lib/site-data'

export const getStaticPaths = (async () => {
  const { briefs } = await getSiteData()
  const numbers = lectureNumbers(briefs.map(b => b.date))
  return briefs.map(brief => ({
    params: { date: brief.date },
    props: { brief, lectureNo: numbers.get(brief.date) ?? 0 },
  }))
}) satisfies GetStaticPaths

interface Props { brief: BriefView, lectureNo: number }
const { brief, lectureNo } = Astro.props
---

<Base
  title={brief.headline}
  issueDate={brief.date}
  description={brief.dailyThesis || brief.summary}
  ogType="article"
>
  <BriefArticle brief={brief} lectureNo={lectureNo} />
</Base>
