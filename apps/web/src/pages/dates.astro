---
import DirectionMark from '../components/DirectionMark.astro'
import Headline from '../components/Headline.astro'
import Base from '../layouts/Base.astro'
import { groupByMonth, lectureNumbers, weekdayLabel } from '../lib/handout'
import { getSiteData } from '../lib/site-data'

const { briefs } = await getSiteData()
const numbers = lectureNumbers(briefs.map(b => b.date))
const months = groupByMonth(briefs)
---

<Base
  title="歷史講義"
  current="archive"
  description={`掐指連總經歷來每一回開盤前重點講義，共 ${briefs.length} 回，依月份排列，可逐日翻閱當天的主軸、牽動的台股與引用來源。`}
>
  <h1>歷史講義</h1>
  <p class="lead">共 {briefs.length} 回，新的在上面。</p>
  {months.length === 0 && <p>還沒有任何一回講義。</p>}
  {months.map(m => (
    <section aria-labelledby={`m-${m.items[0]?.date.slice(0, 7)}`}>
      <h2 id={`m-${m.items[0]?.date.slice(0, 7)}`}>{m.month}</h2>
      <ol>
        {m.items.map(b => (
          <li>
            <span class="when">
              第 {numbers.get(b.date)} 回・{b.date.slice(5).replace('-', '/')}（{weekdayLabel(b.date)}）
              {b.audioUrl && (
                <span class="audio">
                  <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><path d="M2 7V6a4 4 0 0 1 8 0v1M2 7h1.6v3.4H2zM8.4 7H10v3.4H8.4z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>
                  <span class="sr">有語音版</span>
                </span>
              )}
            </span>
            <a href={`/d/${b.date}`}><Headline text={b.headline} /></a>
            {b.industries.length > 0 && (
              <ul class="ind" aria-label="牽動產業">
                {b.industries.map(i => <li>{i.name}<DirectionMark direction={i.direction} /></li>)}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </section>
  ))}
</Base>

<style>
  h1 {
    margin: 14px 0 0;
    font-size: 24px;
    font-weight: 900;
  }
  .lead {
    margin: 2px 0 0;
    font-size: 14px;
    color: var(--ink-2);
  }
  section {
    max-width: 68ch;
    margin-top: 32px;
  }
  h2 {
    margin: 0;
    padding-bottom: 4px;
    border-bottom: 2px solid var(--ink);
    font-size: 17px;
    font-weight: 900;
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ol > li {
    padding: 10px 0;
    border-bottom: 1px dashed var(--rule);
    line-height: 1.6;
  }
  .when {
    display: block;
    font-size: 12.5px;
    color: var(--ink-2);
  }
  .audio {
    position: relative;
    display: inline-flex;
    vertical-align: -1px;
    margin-left: 0.4em;
    color: var(--blue);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* 形狀加文字，不靠顏色單獨表意（紅漲綠跌對色弱讀者不可靠）。 */
  .ind {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    color: var(--ink-2);
  }
  .ind li {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    white-space: nowrap;
  }
  li a {
    font-weight: 500;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
</style>
