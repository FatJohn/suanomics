---
import type { GetStaticPaths } from 'astro'
import type { NewsRow } from '../../../lib/db/site-repo'
import Base from '../../../layouts/Base.astro'
import { redactBlockedSentences } from '../../../lib/compliance'
import { safeHttpUrl, WITHHELD_NEWS_TITLE } from '../../../lib/present-brief'
import { getSiteData } from '../../../lib/site-data'

export const getStaticPaths = (async () => {
  const { news } = await getSiteData()
  return news.map(item => ({ params: { id: String(item.id) }, props: { item } }))
}) satisfies GetStaticPaths

interface Props { item: NewsRow }
const { item } = Astro.props
const title = redactBlockedSentences(item.title) || WITHHELD_NEWS_TITLE
const href = safeHttpUrl(item.url)
---

<Base title={title}>
  <h1 class="my-2 text-2xl font-bold">{title}</h1>
  <p class="text-sm text-neutral-500">
    {item.sourceName}{item.publishedAt && `・${item.publishedAt.toISOString().slice(0, 10)}`}
  </p>
  {href && <p class="my-3"><a class="underline" href={href} rel="noopener">閱讀原文</a></p>}
</Base>
