---
import { SITE_NAME } from '@suanomics/shared'
import { weekdayLabel } from '../lib/handout'
import { absoluteUrl, metaDescription } from '../lib/seo'
import { pageTitle } from '../lib/title'
import '../styles/global.css'

interface Props {
  title?: string
  // 講義抬頭右側的日期；歷史與新聞頁沒有單一日期就不帶。
  issueDate?: string | undefined
  current?: 'today' | 'archive'
  // 社群分享卡片的摘要；沒給就用全站說明。
  description?: string | undefined
  // 分享卡片的標題預設同 <title>；首頁 <title> 固定是站名，卡片改用當天標題。
  ogTitle?: string | undefined
  ogType?: 'website' | 'article'
}
const { title, issueDate, current, description, ogTitle, ogType = 'website' } = Astro.props
const site = Astro.site?.href ?? Astro.url.origin
const canonical = absoluteUrl(Astro.url.pathname, site)
const ogImage = absoluteUrl('/og-image.png', site)
const desc = metaDescription(description)
const cardTitle = ogTitle ?? pageTitle(title)
---

<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f6f8" />
    <title>{pageTitle(title)}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={cardTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}：賽博半仙・算命不如算力`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#content">跳到本文</a>
    <div class="page">
      <header class="masthead">
        <a class="brand" href="/">
          <img class="brand-mark" src="/logo-mark.svg" alt="" width="40" height="40" />
          <span>
            <b>{SITE_NAME}</b>
            <small>賽博半仙・算命不如算力</small>
          </span>
        </a>
        <p class="meta">
          開盤前重點講義
          {issueDate && <strong>{issueDate}（{weekdayLabel(issueDate)}）</strong>}
        </p>
      </header>
      <nav class="nav" aria-label="網站">
        <a href="/" aria-current={current === 'today' ? 'page' : undefined}>今日講義</a>
        <a href="/dates" aria-current={current === 'archive' ? 'page' : undefined}>歷史講義</a>
      </nav>
      <main id="content"><slot /></main>
      <footer class="foot">
        <p class="sign">今天就畫到這裡。掐指算不準的，交給算力；算力算不準的，回頭看出處。</p>
        <p>本站內容由程式依公開資料整理，僅供參考、非投資建議。</p>
        <p><a href="https://github.com/FatJohn/suanomics">原始碼</a>公開在 GitHub，以 Apache-2.0 授權。</p>
      </footer>
    </div>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -48px;
    background: var(--blue);
    color: #fff;
    padding: 6px 12px;
    z-index: 1;
  }
  .skip:focus {
    top: 8px;
  }
  .page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 16px 32px;
  }
  .masthead {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 12px;
    padding: 14px 0 8px;
    border-bottom: 3px solid var(--ink);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.35;
  }
  .brand-mark {
    flex: none;
    width: 40px;
    height: 40px;
  }
  .brand b {
    display: block;
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 0.06em;
  }
  .brand small {
    display: block;
    font-size: 12px;
    color: var(--ink-2);
    letter-spacing: 0.12em;
  }
  .meta {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    text-align: right;
  }
  .meta strong {
    display: block;
    color: var(--blue);
    font-size: 14px;
  }
  .nav {
    display: flex;
    gap: 18px;
    padding: 6px 0 14px;
    font-size: 14px;
  }
  .nav a {
    color: var(--ink-2);
    text-decoration: none;
    padding: 4px 0;
  }
  .nav a:hover {
    color: var(--blue);
  }
  .nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
    box-shadow: inset 0 -2px 0 var(--blue);
  }
  /* 375×667 這類矮手機的首屏要放得下本日必考重點的全部產業列（#96），抬頭與導覽讓出高度。 */
  @media (max-width: 480px) and (max-height: 740px) {
    .masthead {
      padding: 8px 0 6px;
    }
    .brand b {
      font-size: 18px;
    }
    .nav {
      padding: 2px 0 6px;
    }
  }
  /* 手機寬度下 40px 的 logo 會把 slogan 擠成兩行、刊頭長高（361px 寬的高螢幕實測過），
     480px 以下一律縮成 36px；360px 以下連 36px 都放不下，只留文字。 */
  @media (max-width: 480px) {
    .brand-mark {
      width: 36px;
      height: 36px;
    }
  }
  @media (max-width: 360px) {
    .brand-mark {
      display: none;
    }
  }
  .foot {
    margin-top: 56px;
    padding-top: 10px;
    border-top: 3px solid var(--ink);
    font-size: 13px;
    color: var(--ink-2);
  }
  .foot p {
    margin: 4px 0;
  }
  .sign {
    color: var(--ink);
    font-weight: 500;
  }
</style>
