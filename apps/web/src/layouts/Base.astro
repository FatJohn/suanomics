---
import { SITE_NAME } from '@suanomics/shared'
import { pageTitle } from '../lib/title'
import '../styles/global.css'

interface Props { title?: string }
const { title } = Astro.props
---

<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle(title)}</title>
  </head>
  <body class="mx-auto max-w-2xl px-4 py-6 leading-relaxed text-neutral-900">
    <nav class="mb-6 flex gap-4 text-sm">
      <a class="font-bold" href="/">{SITE_NAME}</a>
      <a class="underline" href="/dates">歷史日期</a>
    </nav>
    <main><slot /></main>
  </body>
</html>
