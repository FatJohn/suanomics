---
import type { BriefView } from '../lib/present-brief'
import { renderMarkdown } from '../lib/markdown'

interface Props { brief: BriefView }
const { brief } = Astro.props
const markdownClass = '[&_p]:my-3'
---

<article>
  <p class="text-sm text-neutral-500">{brief.date}</p>
  <h1 class="my-2 text-2xl font-bold">{brief.headline}</h1>
  {brief.dailyThesis && <p class="font-medium">{brief.dailyThesis}</p>}
  {brief.summary && <p class="my-3">{brief.summary}</p>}

  {brief.narrative && (
    <>
      <div class={markdownClass} set:html={renderMarkdown(brief.narrative.intro)} />
      {brief.narrative.sections.map(section => (
        <section>
          {section.heading && <h2 class="mt-6 text-xl font-bold">{section.heading}</h2>}
          {section.takeaway && <p class="font-medium">{section.takeaway}</p>}
          <div class={markdownClass} set:html={renderMarkdown(section.body)} />
          {section.citations.length > 0 && (
            <p class="text-sm">
              來源：{section.citations.map((c, i) => <>{i > 0 && '、'}<a class="underline" href={c.url} rel="noopener">{c.title}</a></>)}
            </p>
          )}
        </section>
      ))}
      <div class={markdownClass} set:html={renderMarkdown(brief.narrative.outro)} />
    </>
  )}

  {brief.viewpoints && (
    <section>
      <h2 class="mt-6 text-xl font-bold">正反觀點</h2>
      {brief.viewpoints.supportPoints.length > 0 && (
        <>
          <h3 class="mt-3 font-bold">支持</h3>
          <ul class="list-disc pl-5">{brief.viewpoints.supportPoints.map(p => <li>{p}</li>)}</ul>
        </>
      )}
      {brief.viewpoints.riskPoints.length > 0 && (
        <>
          <h3 class="mt-3 font-bold">風險</h3>
          <ul class="list-disc pl-5">{brief.viewpoints.riskPoints.map(p => <li>{p}</li>)}</ul>
        </>
      )}
      {brief.viewpoints.netRead && <p class="my-3">{brief.viewpoints.netRead}</p>}
    </section>
  )}

  {brief.selectedNews.length > 0 && (
    <section>
      <h2 class="mt-6 text-xl font-bold">本日選稿</h2>
      <ul class="list-disc pl-5">{brief.selectedNews.map(n => <li><a class="underline" href={`/brief/news/${n.id}`}>{n.title}</a></li>)}</ul>
    </section>
  )}

  <section>
    <h2 class="mt-6 text-xl font-bold">引用來源</h2>
    {brief.citations.length > 0
      ? <ol class="list-decimal pl-5">{brief.citations.map(c => <li><a class="underline" href={c.url} rel="noopener">{c.title}</a></li>)}</ol>
      : <p>資料不足</p>}
  </section>

  <p class="mt-6 text-sm text-neutral-500">{brief.disclaimer}</p>
</article>
