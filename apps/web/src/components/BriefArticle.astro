---
import type { BriefView } from '../lib/present-brief'
import { briefHtml } from '../lib/brief-html'
import { GLOSSARY } from '../lib/glossary-terms'
import { readingMinutes } from '../lib/handout'
import Headline from './Headline.astro'
import KeyPoints from './KeyPoints.astro'
import PodcastPlayer from './PodcastPlayer.astro'
import SourceLinks from './SourceLinks.astro'
import Viewpoints from './Viewpoints.astro'

interface Props { brief: BriefView, lectureNo: number }
const { brief, lectureNo } = Astro.props
const narrative = brief.narrative
const sections = narrative?.sections ?? []
const minutes = readingMinutes([
  brief.dailyThesis,
  narrative ? [narrative.intro, ...sections.flatMap(s => [s.takeaway, s.body]), narrative.outro].join('') : brief.summary,
])

const { thesisHighlightHtml, thesisRestHtml, introHtml, bodyHtml, outroHtml, summaryHtml, viewpoints, industries } = briefHtml(brief, GLOSSARY)

const toc = [
  { id: 'key', label: '本日必考重點' },
  ...(brief.audioUrl ? [{ id: 'podcast', label: '收聽今日講義' }] : []),
  ...(narrative ? [{ id: 'intro', label: '導讀' }] : []),
  ...sections.map((s, i) => ({ id: `sec-${i + 1}`, label: `詳解 ${i + 1}：${s.heading}` })),
  ...(brief.viewpoints ? [{ id: 'views', label: '正反觀點' }] : []),
  { id: 'sources', label: '出處' },
]
---

<div class="layout">
  <article class="brief">
    <p class="fields">
      <span>第 {lectureNo} 回</span><span>閱讀 {minutes} 分鐘</span><a href="#sources">來源 {brief.sources.length} 則</a>
      {brief.audioUrl && <a class="listen" href="#podcast"><svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><path d="M3 2v8l7-4z" fill="currentColor" /></svg><span class="label">收聽語音版</span></a>}
    </p>
    <h1><Headline text={brief.headline} /></h1>

    <KeyPoints thesisHighlightHtml={thesisHighlightHtml} thesisRestHtml={thesisRestHtml} industries={industries} />

    {brief.audioUrl && <PodcastPlayer url={brief.audioUrl} />}

    {narrative
      ? (
          <>
            <section id="intro" aria-labelledby="intro-title">
              <h2 id="intro-title">導讀</h2>
              <div class="prose-handout" set:html={introHtml} />
            </section>
            {sections.map((s, i) => (
              <section id={`sec-${i + 1}`} aria-labelledby={`sec-${i + 1}-title`}>
                <h2 id={`sec-${i + 1}-title`}><span class="no">詳解 {i + 1}／{sections.length}</span>{s.heading}</h2>
                {s.takeaway && <p class="take">{s.takeaway}</p>}
                <div class="prose-handout" set:html={bodyHtml[i]} />
                <SourceLinks label="出處" links={s.citations} />
              </section>
            ))}
            {outroHtml && <div class="prose-handout outro" set:html={outroHtml} />}
          </>
        )
      : summaryHtml && <p set:html={summaryHtml} />}

    {viewpoints && <Viewpoints viewpoints={viewpoints} />}

    <section id="sources" aria-labelledby="sources-title">
      <h2 id="sources-title">出處</h2>
      {brief.sources.length > 0
        ? (
            <ul class="sources">
              {brief.sources.map(s => (
                <li>
                  <span class="src-meta">{s.sourceName}{s.date && `・${s.date}`}</span>
                  {s.url ? <a href={s.url} rel="noopener">{s.title}</a> : s.title}
                  {s.newsId !== null && <a class="pick" href={`/brief/news/${s.newsId}`}>選稿</a>}
                </li>
              ))}
            </ul>
          )
        : <p>資料不足</p>}
    </section>

    <p class="disclaimer">{brief.disclaimer}</p>
  </article>

  <nav class="toc" aria-label="本講義目錄">
    <p class="toc-title">本講義目錄</p>
    <ol>{toc.map(t => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol>
  </nav>
</div>

<style>
  .layout {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: minmax(0, 68ch) 15rem;
      justify-content: space-between;
    }
  }
  article {
    min-width: 0;
  }
  .fields {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 0;
    padding: 6px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 12.5px;
    color: var(--ink-2);
  }
  .fields > span,
  .fields > a:not(.listen) {
    padding: 0 4px;
    line-height: 1.6;
  }
  .fields .listen {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0 6px;
    border: 1px solid var(--blue);
    color: var(--blue);
    font-weight: 700;
    /* 上下各 1px 框線，比其他格的 1px 底線多 1px；行高少 1px 讓整列和沒有音檔時一樣高（#96 首屏）。 */
    line-height: 19px;
    text-decoration: none;
  }
  .fields .listen:hover,
  .fields .listen:focus-visible {
    background: var(--blue);
    color: #fff;
  }
  h1 {
    margin: 14px 0 0;
    font-size: clamp(21px, 1.2rem + 1vw, 30px);
    font-weight: 900;
    line-height: 1.45;
    letter-spacing: 0.01em;
  }
  /* 矮手機首屏要放得下全部產業列（#96）。 */
  @media (max-width: 480px) and (max-height: 740px) {
    .fields {
      padding: 2px 0;
    }
    h1 {
      margin-top: 8px;
      font-size: 20px;
      line-height: 1.4;
    }
  }
  /* 窄螢幕上入口帶文字會讓欄位列折成兩行；只留圖示，文字留給讀屏器。 */
  @media (max-width: 360px), (max-width: 480px) and (max-height: 740px) {
    .fields:has(.listen) {
      column-gap: 8px;
    }
    .fields .listen {
      padding: 0 4px;
    }
    .listen .label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  h2 .no {
    white-space: nowrap;
    margin-right: 0.5em;
    font-size: 0.8em;
    color: var(--blue);
    letter-spacing: 0.12em;
  }
  /* 紅筆是劃線不是字色：紅色在本站代表上漲，負數印成紅字會被讀反。 */
  .take {
    margin: 6px 0 0;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.32em;
    font-size: 15.5px;
    line-height: 1.75;
  }
  .outro {
    margin-top: 28px;
    padding-top: 6px;
    border-top: 1px solid var(--rule);
  }
  .sources {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sources li {
    padding: 6px 0;
    border-top: 1px dashed var(--rule);
    font-size: 15px;
    line-height: 1.7;
  }
  .src-meta {
    margin-right: 0.6em;
    font-size: 13px;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  /* 和正反觀點的「見詳解 N」同一種方框標籤：藍框藍字、hover 反白。 */
  .pick {
    display: inline-block;
    margin-left: 0.4em;
    padding: 0 4px;
    font-size: 12.5px;
    line-height: 1.6;
    white-space: nowrap;
    color: var(--blue);
    text-decoration: none;
    border: 1px solid var(--blue);
  }
  .pick:hover {
    background: var(--blue);
    color: var(--paper);
  }
  .disclaimer {
    margin: 40px 0 0;
    font-size: 13px;
    color: var(--ink-2);
  }
  .toc {
    display: none;
  }
  @media (min-width: 1024px) {
    .toc {
      display: block;
      position: sticky;
      top: 24px;
      align-self: start;
      border-top: 3px solid var(--ink);
      padding-top: 8px;
      font-size: 13.5px;
      line-height: 1.6;
    }
  }
  .toc-title {
    margin: 0 0 6px;
    font-weight: 900;
    letter-spacing: 0.12em;
  }
  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc li {
    padding: 5px 0;
    border-top: 1px dashed var(--rule);
  }
  .toc a {
    color: var(--ink);
    text-decoration-color: var(--rule);
  }
  .toc a:hover {
    color: var(--blue);
    text-decoration-color: var(--blue);
  }
</style>
