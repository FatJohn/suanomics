---
import type { ViewpointView } from '../lib/present-brief'

// 各 *Html 欄是已跳脫並標好術語的 HTML（BriefArticle 依整頁閱讀順序標），會用 set:html 輸出；
// 欄位名和 BriefView 的純文字欄位不同，未跳脫的文字傳不進來。
type PointRow = Omit<ViewpointView, 'text'> & { html: string }
interface Props { viewpoints: { thesisHtml: string, support: PointRow[], risk: PointRow[], netReadHtml: string } }
const { viewpoints } = Astro.props
const columns = [
  { title: '支持主軸成立的理由', points: viewpoints.support },
  { title: '可能推翻主軸的風險', points: viewpoints.risk },
].filter(c => c.points.length > 0)
---

<section id="views" aria-labelledby="views-title">
  <h2 id="views-title">正反觀點</h2>
  <p class="claim">
    {viewpoints.thesisHtml
      ? <>檢驗的主軸：<q set:html={viewpoints.thesisHtml} /></>
      : '檢驗的是本日主軸。'}
    <a href="#key">回到本日必考重點</a>
  </p>
  {columns.length > 0 && (
    <div class="cols">
      {columns.map(c => (
        <div>
          <h3>{c.title}</h3>
          <ul>
            {c.points.map(p => (
              <li>
                <Fragment set:html={p.html} />
                {typeof p.section === 'number' && <a class="ref" href={`#sec-${p.section}`}>見詳解 {p.section}</a>}
                {p.section === 'overall' && <span class="ref">整體判斷</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}
  {viewpoints.netReadHtml && (
    <div class="net">
      <h3>總結</h3>
      <p set:html={viewpoints.netReadHtml} />
    </div>
  )}
</section>

<style>
  .claim {
    margin: 4px 0 0;
    font-size: 15px;
    line-height: 1.75;
  }
  .claim q {
    font-weight: 500;
  }
  .claim a {
    display: inline-block;
    margin-left: 0.5em;
    font-size: 13.5px;
    white-space: nowrap;
  }
  .ref {
    display: inline-block;
    margin-left: 0.4em;
    padding: 0 4px;
    font-size: 12.5px;
    line-height: 1.9;
    white-space: nowrap;
    color: var(--ink-2);
    border: 1px solid var(--rule);
  }
  a.ref {
    color: var(--blue);
    text-decoration: none;
    border-color: var(--blue);
  }
  a.ref:hover {
    background: var(--blue);
    color: var(--paper);
  }
  .cols {
    display: grid;
    gap: 4px 28px;
  }
  @media (min-width: 640px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  h3 {
    margin: 14px 0 2px;
    font-size: 15px;
    font-weight: 900;
  }
  ul {
    margin: 0;
    padding-left: 1.2em;
    list-style: disc;
  }
  li {
    margin: 6px 0;
    font-size: 15px;
    line-height: 1.75;
  }
  li::marker {
    color: var(--blue);
  }
  .net {
    margin-top: 22px;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    padding: 4px 0 8px;
  }
  .net h3 {
    color: var(--red);
    letter-spacing: 0.12em;
  }
  .net p {
    margin: 4px 0 0;
  }
</style>
