{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "apps/pipeline": {
      "entry": [
        "src/index.ts",
        "src/db/repos/*.ts",
        "src/ingest/market-data/context.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,astro}"]
    }
  }
}
