# 只列 key 名，不放任何值。本機複製成 .env 後自行填入；CI 的值放 GitHub Environment `production`。
ANTHROPIC_API_KEY=
AGENT_MODELS=
DAILY_COST_LIMIT_USD=
DATABASE_URL=
WEB_DATABASE_URL=
WEB_REQUIRE_DATABASE=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
FRED_API_KEY=
GITHUB_DISPATCH_TOKEN=
EIA_API_KEY=
FIRECRAWL_API_KEY=
NEWS_CATEGORY_FLOORS=
ANALYST_CLAIMS_ENABLED=
NARRATIVE_LEDGER_ENABLED=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# 每個新聞來源內同時抓幾篇正文，來源之間仍逐一處理；未設、無法解析或為 0 時用 3，負數視為 1。
NEWS_FETCH_CONCURRENCY=
# 設為 true 時，db:seed 與 apps/pipeline/src/db/seed-external-sources.ts 會啟用商業媒體等第三方來源；未設時預設停用。
SEED_THIRD_PARTY_SOURCES=
# 設為 true 表示確認要把資料庫裡已啟用的第三方來源改成停用；未設時 seed 遇到這種情況會中止。
SEED_ALLOW_DOWNGRADE=
